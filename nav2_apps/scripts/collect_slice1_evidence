#!/usr/bin/env bash

set -euo pipefail

find_repo_root() {
  if [[ -n "${NAV2_APPS_REPO_ROOT:-}" ]] &&
    git -C "${NAV2_APPS_REPO_ROOT}" rev-parse --show-toplevel >/dev/null 2>&1; then
    git -C "${NAV2_APPS_REPO_ROOT}" rev-parse --show-toplevel
    return
  fi

  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    git rev-parse --show-toplevel
    return
  fi

  package_prefix="$(ros2 pkg prefix nav2_apps 2>/dev/null || true)"
  workspace_root="${package_prefix%/install/nav2_apps}"
  source_candidate="${workspace_root}/src/warehouse_project"
  if [[ "${workspace_root}" != "${package_prefix}" ]] &&
    git -C "${source_candidate}" rev-parse --show-toplevel >/dev/null 2>&1; then
    git -C "${source_candidate}" rev-parse --show-toplevel
    return
  fi

  echo "Cannot locate warehouse_project Git repository." >&2
  echo "Run inside the repository or set NAV2_APPS_REPO_ROOT." >&2
  return 1
}

repo_root="$(find_repo_root)"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
output_dir="${repo_root}/nav2_apps/runtime_logs/slice1_${timestamp}"
mkdir -p "${output_dir}"

{
  echo "timestamp_utc: ${timestamp}"
  echo "environment: ${ROS_DISTRO:-unknown}"
  echo "commit_sha: $(git -C "${repo_root}" rev-parse HEAD)"
  echo "command: $*"
  echo "working_tree_status: |"
  git -C "${repo_root}" status --short | sed 's/^/  /'
} > "${output_dir}/metadata.yaml"

if [[ $# -gt 0 ]]; then
  set +e
  "$@" 2>&1 | tee "${output_dir}/command.log"
  command_status=${PIPESTATUS[0]}
  set -e
  echo "command_exit_code: ${command_status}" >> "${output_dir}/metadata.yaml"
else
  command_status=0
  echo "command_exit_code: not_run" >> "${output_dir}/metadata.yaml"
fi

echo "Raw Slice 1 evidence: ${output_dir}"
exit "${command_status}"
